generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id          String   @id @default(uuid())
  title       String
  department  String
  location    String
  type        String
  salary      String?
  description String
  requirements String
  benefits    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  interviewTemplates InterviewTemplate[]

  @@map("careers_job")
}

model Application {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])

  firstName   String
  lastName    String
  email       String
  phone       String
  address     String?
  city        String?
  state       String?
  zipCode     String?

  resumeText  String?
  coverLetter String?
  linkedIn    String?
  portfolio   String?
  yearsExp    String?

  startDate   String?
  referral    String?
  legallyAuth String?
  additionalInfo String?

  status      String   @default("New")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("careers_application")
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  @@map("careers_admin_user")
}

model InterviewTemplate {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  round         Int      @default(1)
  format        String   @default("self_paced")
  liveConfig    Json?
  jobId         String?
  job           Job?     @relation(fields: [jobId], references: [id])
  roleTitle     String?
  intro         String?
  questions     Json
  videoRequired Boolean  @default(false)
  // Session-level capture config (captureMode, maxSubmissions). Nullable so
  // pre-existing rows and other services that don't know about it are unaffected.
  config        Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions   InterviewSubmission[]
  accesses      InterviewAccess[]

  @@index([jobId])
  @@map("careers_interview_template")
}

model InterviewAccess {
  id               String    @id @default(uuid())
  token            String    @unique
  interviewId      String
  interview        InterviewTemplate @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  jobId            String?
  round            Int       @default(1)
  fullName         String
  email            String
  phone            String?
  status           String    @default("invited")
  // Number of times this candidate has submitted this round (vs config.maxSubmissions).
  attemptsUsed     Int       @default(0)
  submissionId     String?   @unique
  submission       InterviewSubmission? @relation(fields: [submissionId], references: [id])
  bookedSlot       DateTime?
  previousAccessId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([interviewId])
  @@index([jobId, email])
  @@map("careers_interview_access")
}

model InterviewSubmission {
  id          String   @id @default(uuid())
  jobSlug     String
  interviewId String?
  interview   InterviewTemplate? @relation(fields: [interviewId], references: [id])
  access      InterviewAccess?
  round       Int      @default(2)
  fullName    String
  email       String
  phone       String
  location    String?
  linkedIn    String?
  yearsExp    String?
  answers     Json
  videoUrls   Json
  status      String   @default("New")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobSlug])
  @@index([interviewId])
  @@map("careers_interview_submission")
}

model InterviewBooking {
  id          String   @id @default(uuid())
  jobSlug     String
  slotStart   DateTime
  fullName    String
  email       String
  phone       String
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([jobSlug, slotStart])
  @@index([jobSlug])
  @@map("careers_interview_booking")
}

// ---------------------------------------------------------------------------
// New evaluation platform identity.
//
// A single account table for the new service, with three roles:
//   DEVELOPER     – AALB staff who run evaluations.
//   MANAGER       – client-org contacts; the source of expectations (Phase 0)
//                   and the owner of the professionals they hire.
//   PROFESSIONAL  – interpreters being evaluated.
//
// Professionals belong to a manager via `managerId`; managers see only their
// own professionals; developers see everyone. This table is additive and does
// not touch the legacy careers_* / partners_* data already in this database.
// ---------------------------------------------------------------------------
model AppUser {
  id                 String  @id @default(uuid())
  email              String  @unique
  password           String
  name               String
  role               String // DEVELOPER | MANAGER | PROFESSIONAL
  status             String  @default("active") // active | disabled
  mustChangePassword Boolean @default(false)

  // Manager ↔ Professional (self-relation).
  managerId     String?
  manager       AppUser?  @relation("ManagerProfessionals", fields: [managerId], references: [id], onDelete: SetNull)
  professionals AppUser[] @relation("ManagerProfessionals")

  // Organization the user belongs to (managers + professionals). Developers
  // (AALB staff) have no organization.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Audit breadcrumb: which account created this one.
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([managerId])
  @@index([organizationId])
  @@map("app_user")
}

// A client institution (e.g. University Hospital). Managers and professionals
// belong to one; the agreement, Phase 0 standards, and reporting hang off it.
model Organization {
  id          String   @id @default(uuid())
  name        String
  status      String   @default("active") // active | disabled
  // Phase 0 / institutional standards alignment. NULL = pending setup;
  // a timestamp means standards are active (valid two years from it). This stays
  // the finalize/unlock signal that candidate gating reads.
  standardsAlignedAt DateTime?
  // Phase 0 self-serve questionnaire (see migration 10_org_phase0). The manager
  // answers on their own time; AALB finalizes via standardsAlignedAt above.
  // Status: not_started | in_progress | submitted | finalized. Answers is a flat
  // map keyed by question id; ids are permanent JSONB keys and never renamed.
  phase0Status      String    @default("not_started")
  phase0Answers     Json      @default("{}")
  phase0SubmittedAt DateTime?
  // What AALB already knows about the institution (see migration
  // 12_org_phase0_config). Developer-authored; seeds the manager's questionnaire.
  phase0Config      Json      @default("{}")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     AppUser[]
  invitations Invitation[]
  planDocuments PlanDocument[]

  @@map("app_organization")
}

// A pending invite to join an organization. The invitee opens the unguessable
// link and sets their own password; the invite is single-use and expires.
model Invitation {
  id             String       @id @default(uuid())
  token          String       @unique
  email          String
  name           String?
  role           String // DEVELOPER | MANAGER | PROFESSIONAL
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String?
  status         String       @default("pending") // pending | accepted | revoked
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("app_invitation")
}

// An institution's written language access plan, collected during Phase 0 so AALB
// can review it (Section 1557 / Title VI / ADA). The file is stored in the
// database as bytes (mirroring partners_file), keyed to the organization. It can
// arrive from the manager in the wizard or from a colleague via an emailed,
// token-gated upload link. This is the plan we review, never the assessment scope.
model PlanDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  filename       String
  mimeType       String
  sizeBytes      Int
  content        Bytes
  uploadedVia    String // "manager" | "link"
  uploaderName   String?
  kind           String       @default("plan") // documentKinds.ts: plan | job_description | evaluation_material | qa_record
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, kind])
  @@map("app_plan_document")
}
