generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id          String   @id @default(uuid())
  title       String
  department  String
  location    String
  type        String
  salary      String?
  description String
  requirements String
  benefits    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  interviewTemplates InterviewTemplate[]

  @@map("careers_job")
}

model Application {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])

  firstName   String
  lastName    String
  email       String
  phone       String
  address     String?
  city        String?
  state       String?
  zipCode     String?

  resumeText  String?
  coverLetter String?
  linkedIn    String?
  portfolio   String?
  yearsExp    String?

  startDate   String?
  referral    String?
  legallyAuth String?
  additionalInfo String?

  status      String   @default("New")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("careers_application")
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  @@map("careers_admin_user")
}

model InterviewTemplate {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  round         Int      @default(1)
  format        String   @default("self_paced")
  liveConfig    Json?
  jobId         String?
  job           Job?     @relation(fields: [jobId], references: [id])
  roleTitle     String?
  intro         String?
  questions     Json
  videoRequired Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions   InterviewSubmission[]
  accesses      InterviewAccess[]

  @@index([jobId])
  @@map("careers_interview_template")
}

model InterviewAccess {
  id               String    @id @default(uuid())
  token            String    @unique
  interviewId      String
  interview        InterviewTemplate @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  jobId            String?
  round            Int       @default(1)
  fullName         String
  email            String
  phone            String?
  status           String    @default("invited")
  submissionId     String?   @unique
  submission       InterviewSubmission? @relation(fields: [submissionId], references: [id])
  bookedSlot       DateTime?
  previousAccessId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([interviewId])
  @@index([jobId, email])
  @@map("careers_interview_access")
}

model InterviewSubmission {
  id          String   @id @default(uuid())
  jobSlug     String
  interviewId String?
  interview   InterviewTemplate? @relation(fields: [interviewId], references: [id])
  access      InterviewAccess?
  round       Int      @default(2)
  fullName    String
  email       String
  phone       String
  location    String?
  linkedIn    String?
  yearsExp    String?
  answers     Json
  videoUrls   Json
  status      String   @default("New")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobSlug])
  @@index([interviewId])
  @@map("careers_interview_submission")
}

model InterviewBooking {
  id          String   @id @default(uuid())
  jobSlug     String
  slotStart   DateTime
  fullName    String
  email       String
  phone       String
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([jobSlug, slotStart])
  @@index([jobSlug])
  @@map("careers_interview_booking")
}
