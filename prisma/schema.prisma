generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id          String   @id @default(uuid())
  title       String
  department  String
  location    String
  type        String
  salary      String?
  description String
  requirements String
  benefits    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  interviewTemplates InterviewTemplate[]

  @@map("careers_job")
}

model Application {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])

  firstName   String
  lastName    String
  email       String
  phone       String
  address     String?
  city        String?
  state       String?
  zipCode     String?

  resumeText  String?
  coverLetter String?
  linkedIn    String?
  portfolio   String?
  yearsExp    String?

  startDate   String?
  referral    String?
  legallyAuth String?
  additionalInfo String?

  status      String   @default("New")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("careers_application")
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  @@map("careers_admin_user")
}

model InterviewTemplate {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  round         Int      @default(1)
  format        String   @default("self_paced")
  liveConfig    Json?
  jobId         String?
  job           Job?     @relation(fields: [jobId], references: [id])
  roleTitle     String?
  intro         String?
  questions     Json
  videoRequired Boolean  @default(false)
  // Session-level capture config (captureMode, maxSubmissions). Nullable so
  // pre-existing rows and other services that don't know about it are unaffected.
  config        Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions   InterviewSubmission[]
  accesses      InterviewAccess[]

  @@index([jobId])
  @@map("careers_interview_template")
}

model InterviewAccess {
  id               String    @id @default(uuid())
  token            String    @unique
  interviewId      String
  interview        InterviewTemplate @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  jobId            String?
  round            Int       @default(1)
  fullName         String
  email            String
  phone            String?
  status           String    @default("invited")
  // Number of times this candidate has submitted this round (vs config.maxSubmissions).
  attemptsUsed     Int       @default(0)
  submissionId     String?   @unique
  submission       InterviewSubmission? @relation(fields: [submissionId], references: [id])
  bookedSlot       DateTime?
  previousAccessId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([interviewId])
  @@index([jobId, email])
  @@map("careers_interview_access")
}

model InterviewSubmission {
  id          String   @id @default(uuid())
  jobSlug     String
  interviewId String?
  interview   InterviewTemplate? @relation(fields: [interviewId], references: [id])
  access      InterviewAccess?
  round       Int      @default(2)
  fullName    String
  email       String
  phone       String
  location    String?
  linkedIn    String?
  yearsExp    String?
  answers     Json
  videoUrls   Json
  status      String   @default("New")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobSlug])
  @@index([interviewId])
  @@map("careers_interview_submission")
}

model InterviewBooking {
  id          String   @id @default(uuid())
  jobSlug     String
  slotStart   DateTime
  fullName    String
  email       String
  phone       String
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([jobSlug, slotStart])
  @@index([jobSlug])
  @@map("careers_interview_booking")
}

// ---------------------------------------------------------------------------
// New evaluation platform identity.
//
// A single account table for the new service, with three roles:
//   DEVELOPER     – AALB staff who run evaluations.
//   MANAGER       – client-org contacts; the source of expectations (Phase 0)
//                   and the owner of the professionals they hire.
//   PROFESSIONAL  – interpreters being evaluated.
//
// Professionals belong to a manager via `managerId`; managers see only their
// own professionals; developers see everyone. This table is additive and does
// not touch the legacy careers_* / partners_* data already in this database.
// ---------------------------------------------------------------------------
model AppUser {
  id                 String  @id @default(uuid())
  email              String  @unique
  password           String
  name               String
  role               String // DEVELOPER | MANAGER | PROFESSIONAL
  status             String  @default("active") // active | disabled
  mustChangePassword Boolean @default(false)

  // Manager ↔ Professional (self-relation).
  managerId     String?
  manager       AppUser?  @relation("ManagerProfessionals", fields: [managerId], references: [id], onDelete: SetNull)
  professionals AppUser[] @relation("ManagerProfessionals")

  // Organization the user belongs to (managers + professionals). Developers
  // (AALB staff) have no organization.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Audit breadcrumb: which account created this one.
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([managerId])
  @@index([organizationId])
  @@map("app_user")
}

// A client institution (e.g. University Hospital). Managers and professionals
// belong to one; the agreement, Phase 0 standards, and reporting hang off it.
model Organization {
  id          String   @id @default(uuid())
  name        String
  status      String   @default("active") // active | disabled
  // Phase 0 / institutional standards alignment. NULL = pending setup;
  // a timestamp means standards are active (valid two years from it).
  standardsAlignedAt DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     AppUser[]
  invitations Invitation[]

  @@map("app_organization")
}

// A pending invite to join an organization. The invitee opens the unguessable
// link and sets their own password; the invite is single-use and expires.
model Invitation {
  id             String       @id @default(uuid())
  token          String       @unique
  email          String
  name           String?
  role           String // DEVELOPER | MANAGER | PROFESSIONAL
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String?
  status         String       @default("pending") // pending | accepted | revoked
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("app_invitation")
}
